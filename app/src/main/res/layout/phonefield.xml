<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Top Icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="◎"
            android:textColor="#222222"
            android:textSize="26sp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⊞"
            android:textColor="#222222"
            android:textSize="24sp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="▽"
            android:textColor="#222222"
            android:textSize="24sp" />

    </LinearLayout>

    <!-- Screen Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Your phone number"
        android:textColor="#222222"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Instructions -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="Please confirm your country code and enter&#10;your phone number."
        android:textColor="#888888"
        android:textSize="14sp" />

    <!-- Country Selection -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/field_border"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Country"
            android:textColor="#888888"
            android:textSize="16sp" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="❯"
            android:textColor="#666666"
            android:textSize="25sp" />

    </LinearLayout>

    <!-- Phone Number Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="24dp"
        android:text="Phone number"
        android:textColor="#70C58A"
        android:textSize="12sp" />

    <!-- Phone Number Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/phone_field_border"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textColor="#222222"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/phoneNumberInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:hint=" "
            android:inputType="phone"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textColor="#222222"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- Sync Contacts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/syncContactsCheckbox"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:buttonTint="#24C65A"
            android:checked="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sync Contacts"
            android:textColor="#222222"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Next Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="end|center_vertical">

        <TextView
            android:id="@+id/nextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/next_button_background"
            android:gravity="center"
            android:text="➜"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />

    </LinearLayout>

    <!-- Push the Numeric Keypad Toward the Bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Custom Numeric Keypad -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1"
                android:textSize="22sp"
                android:textColor="#222222"
                android:backgroundTint="#EEEEEE" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2   ABC"
                android:textSize="18sp"
                android:textColor="#222222"
                android:backgroundTint="#EEEEEE" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3   DEF"
                android:textSize="18sp"
                android:textColor="#222222"
                android:backgroundTint="#EEEEEE" />

        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="4   GHI"
                android:textSize="18sp"
                android:textColor="#222222"
                android:backgroundTint="#EEEEEE" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="5   JKL"
                android:textSize="18sp"
                android:textColor="#222222"
                android:backgroundTint="#EEEEEE" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="6   MNO"
                android:textSize="18sp"
                android:textColor="#222222"
                android:backgroundTint="#EEEEEE" />

        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="7   PQRS"
                android:textSize="16sp"
                android:textColor="#222222"
                android:backgroundTint="#EEEEEE" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="8   TUV"
                android:textSize="16sp"
                android:textColor="#222222"
                android:backgroundTint="#EEEEEE" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="9   WXYZ"
                android:textSize="16sp"
                android:textColor="#222222"
                android:backgroundTint="#EEEEEE" />

        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="0"
                android:textSize="22sp"
                android:textColor="#222222"
                android:backgroundTint="#EEEEEE" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="+"
                android:textSize="22sp"
                android:textColor="#222222"
                android:backgroundTint="#EEEEEE" />

            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⌫"
                android:textSize="24sp"
                android:textColor="#222222"
                android:backgroundTint="#EEEEEE" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
